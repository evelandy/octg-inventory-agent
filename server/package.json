{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:make": "sequelize-cli migration:generate --name",
    "db:ping": "tsx src/scripts/ping.ts",
    "claude:ask": "tsx src/scripts/ask-claude.ts",
    "seed:inventory": "tsx src/db/seeders/inventory.ts",
    "db:fixtures": "tsx src/scripts/setup-fixtures.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "mocha": "^11.8.0",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8"
  }
}
